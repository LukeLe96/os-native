        "CoreAudio (Sub-millisecond Audio Format Conversion) & Offline TTS": ["apple-audio-convert", "apple-tts"],
        "SoundAnalysis (300+ Class Sound Event Classification)": ["apple-sound-classify"],
        "NaturalLanguage Embeddings (512-dim Sentence Vectors & Word Similarity)": ["apple-embed", "apple-semantic"],
