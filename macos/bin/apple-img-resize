#!/usr/bin/env bash
if [ -z "$1" ] || [ -z "$2" ] || [ -z "$3" ]; then
  echo "Usage: apple-img-resize <input_image> <max_dimension_px> <output_image>"
  exit 1
fi
INPUT="$1"
SIZE="$2"
OUTPUT="$3"
cp "$INPUT" "$OUTPUT"
sips -Z "$SIZE" "$OUTPUT" > /dev/null
echo "Resized $INPUT to max dimension ${SIZE}px -> $OUTPUT"
