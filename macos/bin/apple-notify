#!/usr/bin/env bash
if [ -z "$1" ] || [ -z "$2" ]; then
  echo "Usage: apple-notify <title> <message> [sound_name=Glass]"
  echo "Available sounds: Basso, Blow, Bottle, Frog, Funk, Glass, Hero, Morse, Ping, Pop, Purr, Sosumi, Submarine, Tink"
  exit 1
fi
TITLE="$1"
MSG="$2"
SOUND="${3:-Glass}"

# Pass values via argv (never interpolate into AppleScript source) to prevent AppleScript injection.
osascript - "$TITLE" "$MSG" "$SOUND" <<'APPLESCRIPT'
on run argv
  display notification (item 2 of argv) with title (item 1 of argv) sound name (item 3 of argv)
end run
APPLESCRIPT
echo "Notification sent: [$TITLE] $MSG (sound: $SOUND)"
