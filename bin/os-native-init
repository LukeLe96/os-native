        "Windows Defender CLI (MpCmdRun Automated Malware Scanning)": ["win-scan.ps1"],
        "Windows Search OLE DB SQL Engine": ["win-search.ps1"],
        "Credential Manager, Clipboard & Toast Notifications": ["win-keychain.ps1", "win-clipboard.ps1", "win-notify.ps1"],
    },
}

def check_command(cmd):
    return shutil.which(cmd) is not None

def swift_source_for(tool):
    src_dir = os.path.join(PROJECT_ROOT, "macos", "src")
    for name in (tool + ".swift", tool.replace("-", "_") + ".swift"):
        path = os.path.join(src_dir, name)
        if os.path.isfile(path):
            return path
    return None

def audit_native_tools(system):
    """Audit the suite's own tools for this platform: presence, executability, dependencies, staleness."""
    catalog = AVAILABLE_TOOLS.get(system)
    if not catalog:
        return {}, [], []
    tool_dir = os.path.join(PROJECT_ROOT, catalog["dir"])
    audit = {}
    for tool, spec in catalog["tools"].items():
        path = os.path.join(tool_dir, tool)
        present = os.path.isfile(path)
        missing_deps = [d for d in spec.get("requires", []) if not check_command(d)]
        entry = {
            "category": spec["category"],
            "kind": spec["kind"],
            "engine": spec["engine"],
            "path": os.path.relpath(path, PROJECT_ROOT),
            "present": present,
            "executable": present and os.access(path, os.X_OK),
            "missing_dependencies": missing_deps,
        }
        if spec["kind"] == "swift":
            src = swift_source_for(tool)
            entry["source"] = os.path.relpath(src, PROJECT_ROOT) if src else None
            # 2s tolerance: a fresh git checkout writes source and binary with near-identical mtimes.
            entry["stale"] = bool(present and src and os.path.getmtime(src) - os.path.getmtime(path) > 2)
        entry["status"] = (
            "missing" if not present else
            "not-executable" if not entry["executable"] else
            "missing-deps" if missing_deps else
            "stale" if entry.get("stale") else
            "ok"
        )
        audit[tool] = entry
    uncataloged = []
    if os.path.isdir(tool_dir):
        uncataloged = sorted(f for f in os.listdir(tool_dir)
                             if not f.startswith(".") and f not in catalog["tools"])
    usable = {t for t, e in audit.items() if e["status"] in ("ok", "stale")}
    capabilities = [cap for cap, tools in CAPABILITIES.get(system, {}).items()
                    if all(t in usable for t in tools)]
    return audit, uncataloged, capabilities

def inspect_environment():
    inventory = {
        "os": SYSTEM,
        "arch": ARCH,
        "release": RELEASE,
        "version": VERSION,
        "hostname": platform.node(),
        "suite_version": SUITE_VERSION,
        "available_tools": {},
        "missing_recommended_tools": [],
        "native_capabilities": [],
        "native_tools": {},
        "uncataloged_tools": []
    }

    if SYSTEM == "Darwin":
        # macOS Inspection
        tools = ["swiftc", "sips", "afconvert", "say", "mdfind", "screencapture", "caffeinate", "purge",
                 "networkQuality", "ditto", "avconvert", "textutil", "ffmpeg", "ffprobe"]
    elif SYSTEM == "Linux":
        tools = ["tesseract", "pdftotext", "pdftoppm", "sox", "ffmpeg", "notify-send", "wl-copy", "xclip", "plocate", "systemd-inhibit"]
    elif SYSTEM == "Windows":
        tools = ["powershell", "cmdkey", "curl"]
    else:
        tools = []

    for t in tools:
        inventory["available_tools"][t] = check_command(t)
        if not inventory["available_tools"][t]:
            inventory["missing_recommended_tools"].append(t)

    audit, uncataloged, capabilities = audit_native_tools(SYSTEM)
    inventory["native_tools"] = audit
    inventory["uncataloged_tools"] = uncataloged
    inventory["native_capabilities"] = capabilities

    return inventory

def prompt_privacy_consent():
    print("\n" + "=" * 70)
    print("🔒 PRIVACY & SECURITY GUARDRAIL:")
    print("=" * 70)
    print("The agent is preparing to search external online sources with your host")
    print(f"telemetry: [OS: {SYSTEM}, Architecture: {ARCH}, Kernel: {RELEASE}].")
    print("Because hardware and OS versions constitute sensitive host fingerprints,")
    print("your explicit authorization is required prior to transmitting this data.\n")
    
    # Check if run with non-interactive flag
    if "--consent" in sys.argv:
        print("[CONSENT GRANTED via --consent flag]")
        return True
    elif "--no-consent" in sys.argv:
        print("[CONSENT DENIED via --no-consent flag]")
        return False

    try:
        choice = input("Do you authorize querying external web sources with this OS fingerprint? (y/N): ").strip().lower()
        return choice in ["y", "yes"]
    except (EOFError, KeyboardInterrupt):
        return False

def generate_agent_search_recommendations(inventory):
    queries = []
    if SYSTEM == "Darwin":
        queries.append(f"macOS {RELEASE} Apple Silicon hidden CLI tools optimization developer")
        queries.append("macOS Apple Vision framework command line swift tools github")
    elif SYSTEM == "Linux":
        distro = "Linux"
        queries.append(f"{distro} {ARCH} zero token native AI tools CLI github")
        queries.append("lightweight poppler libvips tesseract cli pipeline linux")
    elif SYSTEM == "Windows":
        queries.append(f"Windows {RELEASE} WinRT PowerShell native OCR DirectML tools github")
        queries.append("Windows Copilot Runtime developer CLI utilities powershell")

    return queries

def main():
    print("=" * 70)
    print(f"🚀 os-native-init: System Inventory & Capability Profiler")
    print("=" * 70)

    inventory = inspect_environment()

    print(f"\n[HOST OVERVIEW]")
    print(f"- Operating System : {inventory['os']}")
    print(f"- Architecture     : {inventory['arch']}")
    print(f"- Kernel Release   : {inventory['release']}")
    print(f"- Machine Hostname : {inventory['hostname']}")

    print(f"\n[NATIVE HARDWARE/OS CAPABILITIES]")
    for cap in inventory["native_capabilities"]:
        print(f"  ✓ {cap}")

    print(f"\n[TOOL INVENTORY AUDIT]")
    for tool, available in inventory["available_tools"].items():
        mark = "✓ INSTALLED" if available else "✗ MISSING"
        print(f"  {mark:<13} : {tool}")

    native = inventory["native_tools"]
    if native:
        ready = sum(1 for e in native.values() if e["status"] == "ok")
        print(f"\n[OS-NATIVE SUITE AUDIT v{SUITE_VERSION}] {ready}/{len(native)} tools ready")
        marks = {"ok": "✓ READY", "stale": "↻ STALE", "missing-deps": "⚠ DEPS",
                 "not-executable": "✗ NO +x", "missing": "✗ MISSING"}
        for tool, e in sorted(native.items(), key=lambda kv: (kv[1]["category"], kv[0])):
            note = ""
            if e["missing_dependencies"]:
                note = f"  (needs: {', '.join(e['missing_dependencies'])})"
            elif e["status"] == "stale":
                note = "  (source newer than binary: ./macos/build.sh " + tool + ")"
            elif e["status"] == "missing" and e["kind"] == "swift":
                note = "  (build: ./macos/build.sh " + tool + ")"
            print(f"  {marks[e['status']]:<10} [{e['category']:<8}] {tool:<24} {e['engine']}{note}")
        if inventory["uncataloged_tools"]:
            print(f"  ? Uncataloged files in {AVAILABLE_TOOLS[SYSTEM]['dir']}/: {', '.join(inventory['uncataloged_tools'])}")

    if inventory["missing_recommended_tools"]:
        print(f"\n⚠️ RECOMMENDED OPTIMIZATIONS:")
        print(f"  The following tools can further unlock zero-token capabilities on this {SYSTEM} machine:")
        for tool in inventory["missing_recommended_tools"]:
            print(f"  - {tool}")
    else:
        print(f"\n✨ EXCELLENT: All baseline native tools are installed and ready!")

    # Check for external research mode
    if "--web-recon" in sys.argv:
        consent = prompt_privacy_consent()
        if consent:
            print("\n[AGENT WEB RECONNAISSANCE INSTRUCTIONS]")
            print("You are authorized to execute the following web searches to discover additional")
            print("specialized packages and optimizations for this machine:")
            queries = generate_agent_search_recommendations(inventory)
            for i, q in enumerate(queries, 1):
                print(f"  Query {i}: \"{q}\"")
            print("\nInstruction for AI Agent:")
            print("Evaluate query results strictly for offline, zero-token, native utilities.")
            print("Synthesize recommendations and present them to the user for confirmation.")
        else:
            print("\n🚫 Operation aborted by user. No host fingerprints were transmitted to the web.")

    # Export JSON if requested
    if "--json" in sys.argv:
        print("\n[JSON INVENTORY DUMP]")
        print(json.dumps(inventory, indent=2))

    return 0

if __name__ == "__main__":
    sys.exit(main())
